# GST COMPLIANCE SYSTEM - ENVIRONMENT VARIABLES
# Copy this file to .env and fill in the actual values for production

# SECURITY CRITICAL - MUST BE SET IN PRODUCTION
SECRET_KEY=your-generated-secret-key-here

# Development/Production Mode
DEBUG=False

# Allowed Hosts - Comma-separated list of domains
ALLOWED_HOSTS=your-production-domain.com,www.your-production-domain.com

# CORS Origins - Comma-separated list of allowed frontend domains
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# Database Configuration (PostgreSQL recommended for production)
DATABASE_URL=postgresql://username:password@localhost:5432/gst_compliance_db

# Email Configuration (for production notifications)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=gst-compliance@your-domain.com

# Optional: Additional Configuration
# STATIC_URL=/static/
# MEDIA_URL=/media/
# TIME_ZONE=Asia/Thimphu